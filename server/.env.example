# ---- Puerto local (detras del tunel de Cloudflare) ----
PORT=5055

# ---- Token que usa el ESP32 para autenticarse al enviar telemetria ----
# Debe coincidir EXACTAMENTE con DEVICE_TOKEN en el sketch WifiESP32Mac.ino
DEVICE_TOKEN=pon-un-token-largo-y-aleatorio

# ---- Login del dashboard (solo tu lo ves) ----
DASH_USER=angel
DASH_PASS=pon-una-clave-fuerte

# ---- Secreto para firmar la cookie de sesion (cualquier cadena larga aleatoria) ----
SESSION_SECRET=cambia-esto-por-algo-aleatorio-largo

# ---- Cookie segura (HTTPS). En produccion detras de Cloudflare: true ----
# Para probar en local por http://localhost ponlo en false.
COOKIE_SECURE=true
